# ===================================================================
#  Teile Thuns - Auskunftshelfer: Einstellungen
#  Diese Datei kopieren nach ".env" und ausfuellen.
#  .env gehoert NICHT ins Repository (siehe .gitignore).
# ===================================================================

# -- Datenbank ------------------------------------------------------
# PostgreSQL 16 mit der Erweiterung pgvector.
# Fertige Anbieter mit pgvector: Neon, Supabase, Render, Railway.
DATABASE_URL=postgresql://benutzer:passwort@host:5432/teilethuns

# -- Geheimnisse ----------------------------------------------------
# Alle drei Werte erzeugt dieser Befehl:   python -m app.passwort_hash
# Das Klartextpasswort steht NIE in dieser Datei.
ADMIN_PASSWORD_HASH=
SESSION_SECRET=
SYNC_API_KEY=

# -- Wer darf den Bot aufrufen? --------------------------------------
# Pflichtangabe. Nur diese Webseiten duerfen den Chatbot einbinden.
# Mehrere durch Komma trennen, ohne Schraegstrich am Ende.
ALLOWED_ORIGINS=https://www.ihr-shop.de,https://ihr-shop.de

# -- Angaben zum Shop -----------------------------------------------
SHOP_NAME=Teile Thuns
EBAY_SHOP_URL=https://www.ebay.de/str/ihr-ebay-shop
OPERATOR_EMAIL=info@ihr-shop.de
OPERATOR_PHONE=0251 1234567

# -- Einbettungen (Bedeutungssuche) ----------------------------------
# local   = Modell laeuft auf dem eigenen Server. Keine Kosten,
#           keine Daten an Dritte. Empfohlen.
# openai  = Fremddienst, braucht OPENAI_API_KEY.
# hashing = Notfall ohne Modell. Findet nur Schreibweisen,
#           keine Bedeutung. Nur fuer Tests.
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DIM=384
# OPENAI_API_KEY=

# -- Betrieb ---------------------------------------------------------
ADMIN_SESSION_MINUTES=30
ADMIN_MAX_ATTEMPTS=5
ADMIN_LOCKOUT_MINUTES=15
CHAT_RATE_PER_MINUTE=30
MAX_MESSAGE_CHARS=500
LOG_LEVEL=INFO
INCIDENT_LOG_PATH=./logs/vorfaelle.jsonl
